{
  "name": "parmar-ai",
  "version": "2.8.0",
  "release_channel": "stable",
  "repository_type": "public-production-source",
  "artifact_policy": "immutable-release-source",
  "runtime": {
    "platform": "Cloudflare Workers",
    "queue": "parmar-ai-questions-prod",
    "dead_letter_queue": "parmar-ai-questions-dlq",
    "durable_object": "JobDedupe",
    "analytics": "Cloudflare D1",
    "ai": "Google Vertex AI / Gemini"
  },
  "limits": {
    "daily_questions": 20,
    "burst_questions": 5,
    "burst_window_seconds": 10,
    "daily_reset": "00:00 Asia/Kolkata",
    "privileged_daily_access": "unlimited",
    "privileged_burst": "5 per 10 seconds",
    "raw_analytics_retention_days": 30
  },
  "access_control": {
    "owner_config": "BOT_OWNER_TELEGRAM_USER_ID",
    "additional_admins_config": "ADMIN_TELEGRAM_USER_IDS",
    "static_unlimited_allowlist": "UNLIMITED_AI_TELEGRAM_USER_IDS",
    "runtime_override_table": "ai_access_overrides",
    "protected_actions": [
      "grant_unlimited",
      "revoke_unlimited",
      "suspend",
      "unsuspend",
      "reset_profile"
    ],
    "burst_protection_applies_to_privileged_users": true,
    "owner_admin_cannot_be_suspended": true,
    "dashboard_grant_verification": "D1 write and effective-access read-back verification"
  },
  "reliability": {
    "lease_fencing": "queue message ID + lease version",
    "processing_lease_seconds": 300,
    "stale_pending_recovery_seconds": 45,
    "stale_queued_recovery_seconds": 120,
    "max_active_job_minutes": 20,
    "typing_only_while_processing": true
  },
  "security": {
    "no_production_secrets_in_repo": true,
    "no_real_user_exports": true,
    "signed_admin_session": true,
    "admin_login_rate_limit": true,
    "admin_mutation_origin_check": true,
    "setup_secret_in_url": false,
    "telegram_encryption_key_required_in_production": true,
    "legacy_telegram_ciphertext_read_migration": true,
    "public_health_detail": "minimal"
  },
  "privacy": {
    "delete_my_data_command": true,
    "reset_is_study_context_only": true
  },
  "accounting": {
    "usage_table": "ai_usage_attempts",
    "dedupe_key": "UNIQUE(update_id, queue_attempt, attempt)",
    "price_defaults_valid_through": "2026-12-31",
    "estimate_only": true
  },
  "build": {
    "source_baseline": "v2.7.0",
    "feature_change": "v2.8.0 production multi-MCQ native Telegram quiz batches up to 10, persistent quiz-result conversation context, and no separate post-vote bot messages",
    "student_path_change": "preserved",
    "release_status": "stable"
  },
  "release_status": "stable"
}
