{
  "name": "parmar-ai",
  "version": "2.8.0",
  "private": true,
  "description": "Telegram-first SSC doubt-solving backend on Cloudflare Workers + Queues + Durable Objects + D1 + Vertex AI.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --config vitest.node.config.ts",
    "format:check": "prettier --check .",
    "dev:vrain": "wrangler dev --config workers/vrain/wrangler.jsonc",
    "deploy:vrain": "wrangler deploy --config workers/vrain/wrangler.jsonc",
    "types:vrain": "wrangler types --config workers/vrain/wrangler.jsonc",
    "check:vrain": "tsc --noEmit -p workers/vrain/tsconfig.json",
    "test:vrain": "vitest run --config workers/vrain/vitest.node.config.ts",
    "dry-run:vrain": "wrangler deploy --dry-run --config workers/vrain/wrangler.jsonc",
    "migrate:vrain:local": "wrangler d1 migrations apply DB --local --config workers/vrain/wrangler.jsonc",
    "migrate:vrain:remote": "wrangler d1 migrations apply DB --remote --config workers/vrain/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.10",
    "@cloudflare/workers-types": "5.20260914.1",
    "@types/node": "22.20.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=22"
  }
}
