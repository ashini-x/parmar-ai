{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brvin-service",
  "main": "src/brvin/service-worker.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "BRVIN_SEARCH_INSTANCE": "fatman-2026-8b183803",
    "BRVIN_MIN_SCORE": "0.2",
    "BRVIN_MATCH_THRESHOLD": "0.3",
    "BRVIN_RERANKING_ENABLED": "true",
    "BRVIN_RERANKING_MODEL": "@cf/baai/bge-reranker-base",
    "BRVIN_RERANKING_MIN_SCORE": "0.4",
    "BRVIN_DEFAULT_MONTHLY_QUERY_LIMIT": "800"
  },
  "ai_search_namespaces": [
    {
      "binding": "BRVIN_SEARCH",
      "namespace": "default"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parmar-ai-admin-prod",
      "database_id": "1c033fb8-10aa-4bee-a294-4dbc899c09f7"
    }
  ]
}
