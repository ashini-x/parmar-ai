{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parmar-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sawalnewton-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
