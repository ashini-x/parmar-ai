{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parmar-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "APP_VERSION": "2.8.0",
    "BURST_QUESTION_LIMIT": "5",
    "BURST_WINDOW_SECONDS": "10",
    "DAILY_QUESTION_LIMIT": "20",
    "ENVIRONMENT": "production",
    "FATMAN_ENABLED": "true",
    "FATMAN_DOCUMENT_VERSION": "fatman-2026-8b183803",
    "FATMAN_INSTANCE_NAME": "fatman-2026-8b183803",
    "FATMAN_MIN_SCORE": "0.2",
    "FATMAN_EXPECTED_PAGES": "538",
    "FATMAN_MONTHLY_QUERY_LIMIT": "800",
    "FATMAN_GCS_BUCKET": "parmar-fatman-ocr-90db7be4",
    "GCP_PROJECT_ID": "project-90db7be4-619f-4ed7-89b",
    "GEMINI_LOCATION": "global",
    "GEMINI_THINKING_LEVEL": "HIGH",
    "ENABLE_GOOGLE_SEARCH_GROUNDING": "true",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "MAX_OUTPUT_TOKENS": "1200",
    "MAX_QUESTION_LENGTH": "4000",
    "VERTEX_TIMEOUT_MS": "25000",
    "ANALYTICS_RAW_RETENTION_DAYS": "30",
    "AI_BUDGET_USD": "",
    "AI_INPUT_USD_PER_MILLION": "0.75",
    "AI_CACHED_INPUT_USD_PER_MILLION": "0.075",
    "AI_OUTPUT_USD_PER_MILLION": "3.75",
    "ADMIN_DASHBOARD_USER": "admin",
    "BRVIN_HOME_ACCOUNT_ID": "b34a6c0b7221454c5db977fe61ddf759",
    "UNLIMITED_AI_TELEGRAM_USER_IDS": ""
  },
  "ai_search_namespaces": [
    {
      "binding": "FATMAN_SEARCH",
      "namespace": "default"
    }
  ],
  "services": [
    {
      "binding": "BRVIN_SERVICE",
      "service": "brvin-service",
      "entrypoint": "BrvinRetrievalApi",
      "props": {
        "clientId": "fatman",
        "applicationEnvironmentId": "00000000-0000-4000-8000-000000000102"
      }
    }
  ],
  "workflows": [
    {
      "name": "parmar-ai-fatman-import",
      "binding": "FATMAN_IMPORT",
      "class_name": "FatmanImportWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_DEDUPE",
        "class_name": "JobDedupe"
      }
    ]
  },
  "exports": {
    "JobDedupe": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parmar-ai-admin-prod",
      "database_id": "1c033fb8-10aa-4bee-a294-4dbc899c09f7"
    }
  ],
  "triggers": {
    "crons": ["30 22 * * *", "*/5 * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "QUESTION_QUEUE",
        "queue": "parmar-ai-questions-prod"
      }
    ],
    "consumers": [
      {
        "queue": "parmar-ai-questions-prod",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "parmar-ai-questions-dlq",
        "retry_delay": 15,
        "max_concurrency": 50
      }
    ]
  },
  "previews": {
    // Isolated preview only: no production BRVIN, AI Search, Workflow or Queue bindings.
    // Never point this DB at parmar-ai-admin-prod or a different application's database.
    "vars": {
      "APP_VERSION": "2.8.0-preview",
      "BRVIN_HOME_ACCOUNT_ID": "",
      "ENVIRONMENT": "preview",
      "FATMAN_ENABLED": "false",
      "DAILY_QUESTION_LIMIT": "20"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "parmar-ai-admin-preview",
        "database_id": "4061b8b7-aeae-4f83-a650-922c68e6f42d"
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "JOB_DEDUPE",
          "class_name": "JobDedupe"
        }
      ]
    }
  }
}
