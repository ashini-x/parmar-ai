{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parmar-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_DEDUPE",
        "class_name": "JobDedupe"
      }
    ]
  },
  "exports": {
    "JobDedupe": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "QUESTION_QUEUE",
        "queue": "parmar-ai-questions-prod"
      }
    ],
    "consumers": [
      {
        "queue": "parmar-ai-questions-prod",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "parmar-ai-questions-dlq",
        "retry_delay": 15,
        "max_concurrency": 50
      }
    ]
  }
}
