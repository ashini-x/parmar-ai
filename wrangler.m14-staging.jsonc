{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parmar-ai-m14-staging",
  "main": "src/brvin/m14-staging-worker.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "APP_VERSION": "m14-staging-1",
    "GCP_PROJECT_ID": "project-90db7be4-619f-4ed7-89b",
    "FATMAN_GCS_BUCKET": "parmar-fatman-ocr-90db7be4",
    "BRVIN_M14_PILOT_ENABLED": "true",
    "BRVIN_M14_CORPUS_BUCKET": "brvin-m14-physics-90db7be4-a8ca999e",
    "BRVIN_M14_VERTEX_LOCATION": "asia-south1",
    "BRVIN_M14_VERTEX_MODEL": "gemini-embedding-001",
    "BRVIN_M14_EMBEDDING_DIMENSIONS": "768",
    "BRVIN_M14_QDRANT_COLLECTION": "brvin_m14_physics_pilot_v1",
    "BRVIN_M15_BENCHMARK_QDRANT_COLLECTION": "brvin_m15_physics_benchmark_v1",
    "BRVIN_M14_QDRANT_URL": "https://8f8aa8b4-c46c-4453-b3b8-f5d6b2c0b146.australia-southeast1-0.gcp.cloud.qdrant.io"
  },
  "ai_search": [
    {
      "binding": "BRVIN_M15_AI_SEARCH",
      "instance_name": "fatman-2026-8b183803"
    },
    {
      "binding": "BRVIN_M15_BENCHMARK_AI_SEARCH",
      "instance_name": "brvin-m15-physics-staging-v1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parmar-ai-m14-staging",
      "database_id": "a8ca999e-4107-4f2f-800e-a1abce3a4cac"
    }
  ]
}
